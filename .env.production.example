# ==============================================================================
# RankPilot Production Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Shopify Partner App Credentials (from https://partners.shopify.com/)
SHOPIFY_API_KEY=your_production_shopify_api_key
SHOPIFY_API_SECRET=your_production_shopify_api_secret

# Production HTTPS URL of the hosted RankPilot application
SHOPIFY_APP_URL=https://rankpilot-five-tan.vercel.app

# Shopify Access Scopes (must match shopify.app.toml)
SCOPES=read_products,write_products,read_inventory,write_inventory,read_themes,write_themes

# Database URL for persistent SQLite storage
DATABASE_URL="file:/data/rankpilot.sqlite"

# Google Gemini API Key for AI Optimization & Spec Matrix Generation
GEMINI_API_KEY=your_production_gemini_api_key

# Search Engine IndexNow Verification Key
INDEXNOW_KEY=rankpilot_indexnow_production_key
INDEXNOW_HOST=api.indexnow.org
